<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.WitziEpisodePosters</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.WitziEpisodePosters</AssemblyName>
    <Version>1.1.23.0</Version>
    <AssemblyVersion>1.1.23.0</AssemblyVersion>
    <FileVersion>1.1.23.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc5">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc5">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Web/ mirrors the resource names these are loaded by, so the project builds from
         its own directory. The theme bundle in scripts/build.mjs reads the same files. -->
    <EmbeddedResource Include="Web\witzi-posters.js">
      <LogicalName>Jellyfin.Plugin.WitziEpisodePosters.Web.witzi-posters.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Web\witzi-critical.css">
      <LogicalName>Jellyfin.Plugin.WitziEpisodePosters.Web.witzi-critical.css</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
