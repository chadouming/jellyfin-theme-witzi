<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.WitziEpisodePosters</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.WitziEpisodePosters</AssemblyName>
    <Version>1.1.24.0</Version>
    <AssemblyVersion>1.1.24.0</AssemblyVersion>
    <FileVersion>1.1.24.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc5">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc5">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Web/ mirrors the resource names these are loaded by, so the project builds from
         its own directory. The theme bundle in scripts/build.mjs reads the same files. -->
    <EmbeddedResource Include="Web\witzi-posters.js">
      <LogicalName>Jellyfin.Plugin.WitziEpisodePosters.Web.witzi-posters.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Web\witzi-critical.css">
      <LogicalName>Jellyfin.Plugin.WitziEpisodePosters.Web.witzi-critical.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Configuration\configPage.html">
      <LogicalName>Jellyfin.Plugin.WitziEpisodePosters.Configuration.configPage.html</LogicalName>
    </EmbeddedResource>
    <!-- The compiled palettes are generated by `npm run build` and committed to dist/.
         They are embedded from there rather than copied into Web/ so a stale second
         copy of a generated file cannot ship in a release, which means the theme build
         has to run before the plugin build. %(Filename) keeps the resource name equal
         to the bundle name, which is what WitziPalettes.ResourceName builds. -->
    <EmbeddedResource Include="..\..\dist\witzi-*.css">
      <LogicalName>Jellyfin.Plugin.WitziEpisodePosters.Web.Themes.%(Filename).css</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
