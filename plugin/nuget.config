<?xml version="1.0" encoding="utf-8"?>
<!--
  The Jellyfin.Controller and Jellyfin.Model release candidates the plugin
  builds against are published to nuget.org. Pinning the source here keeps
  `dotnet build` working on a machine with no user-level NuGet configuration,
  which is otherwise the first thing to fail on a fresh checkout.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
